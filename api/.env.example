# Puerto donde escucha la API (por defecto 3000)
PORT=3000

# Para simular.js: dirección de la API a la que se envían los puntos
API_URL=http://localhost:3000

# OPCIONAL: guardar las ubicaciones en MySQL (base creada con db/esquema.sql).
# Si dejas DB_HOST vacío o borras estas líneas, la API funciona solo en memoria.
DB_HOST=
DB_PORT=3306
# Usa un usuario que solo tenga permisos sobre truck_on_route, nunca root (constitución IV)
DB_USER=truck_app
DB_PASSWORD=
DB_NAME=truck_on_route

# Versión 2.8 (spec 004): cuenta del administrador que se crea la PRIMERA vez que arranca la API.
# Si no las pones, se usan admin@truckonroute.mx / Admin2026 (cámbiala antes de publicar la API).
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Versión 2.15 (spec 011): para publicar en Railway (ver docs/railway.md)
# PRODUCCION=1 no deja arrancar sin una ADMIN_CONTRASENA propia y no crea las cuentas de ejemplo
PRODUCCION=
# Si la pones, POST /ubicacion solo acepta ubicaciones con la cabecera X-Clave-GPS igual a esta clave
CLAVE_GPS=
# Carpeta donde se guardan tor-datos.json y los archivos del chat (en Railway, el Volume: /data)
DATOS_DIR=
# En lugar de DB_HOST, DB_USER...: una sola dirección mysql://usuario:contraseña@host:puerto/base
DB_URL=
